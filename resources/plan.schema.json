{
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "inspect",
        "candidate",
        "blocked"
      ],
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
            "type": "string"
          },
          "op": {
            "enum": [
              "read",
              "search",
              "shell"
            ],
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "limit": {
            "description": "read: default 2000, range 1..2000. Other operations: default 80, maximum 1000.",
            "maximum": 2000,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "description": "search mode only; exact uses literal case-sensitive original text.",
            "enum": [
              "exact",
              "semantic"
            ],
            "type": "string"
          },
          "intent": {
            "enum": [
              "locate",
              "diagnostic",
              "audit"
            ],
            "type": "string"
          },
          "required_entities": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "required_kinds": {
            "items": {
              "enum": [
                "code",
                "document",
                "tool_result",
                "log"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "cursor": {
            "description": "Opaque continuation from search or read; empty for an initial request.",
            "type": "string"
          },
          "from_step": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "expected_exit": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "op",
          "path",
          "query",
          "offset",
          "limit",
          "mode",
          "intent",
          "required_entities",
          "required_kinds",
          "cursor",
          "from_step",
          "command",
          "expected_exit"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "test_code": {
      "type": "string"
    },
    "test_driver": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "regression_command": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "note",
    "steps",
    "test_code",
    "test_driver",
    "regression_command"
  ],
  "type": "object"
}
