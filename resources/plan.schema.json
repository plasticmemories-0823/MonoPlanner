{
  "additionalProperties": false,
  "properties": {
    "kind": {
      "description": "inspect investigates; candidate submits work for actual acceptance. blocked reports an unverified obstacle and receives rework feedback; it cannot pause or complete the task.",
      "enum": [
        "inspect",
        "candidate",
        "blocked"
      ],
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
            "type": "string"
          },
          "op": {
            "description": "read: known original ranges; search: locate evidence through RAG; shell: editing, execution and runtime diagnostics, never evidence search.",
            "enum": [
              "read",
              "search",
              "shell"
            ],
            "type": "string"
          },
          "path": {
            "description": "Authorized repository scope, $record path or host-registered $container namespace. Never widen the registered scope.",
            "type": "string"
          },
          "query": {
            "description": "Search text: one complete case-sensitive literal string.",
            "type": "string"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "limit": {
            "description": "read: default 2000, range 1..2000. Other operations: default 80, maximum 1000.",
            "maximum": 2000,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "description": "One case-sensitive literal substring query. Preserve whitespace and repeated text; BM25 ranks matching files automatically.",
            "enum": [
              "exact"
            ],
            "type": "string"
          },
          "intent": {
            "enum": [
              "locate",
              "diagnostic",
              "audit"
            ],
            "type": "string"
          },
          "required_entities": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "required_kinds": {
            "items": {
              "enum": [
                "code",
                "document",
                "tool_result",
                "log"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "cursor": {
            "description": "Opaque continuation from search or read; empty for an initial request.",
            "type": "string"
          },
          "from_step": {
            "type": "string"
          },
          "command": {
            "description": "Shell code for editing, execution or runtime diagnostics; do not search existing source, documents or saved logs here.",
            "type": "string"
          },
          "expected_exit": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "op",
          "path",
          "query",
          "offset",
          "limit",
          "mode",
          "intent",
          "required_entities",
          "required_kinds",
          "cursor",
          "from_step",
          "command",
          "expected_exit"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "test_code": {
      "description": "Complete Python unittest source with actual newline characters. Do not wrap the entire test module in exec/eval of an encoded string: test attribution must retain real source locations. The test file is outside the project; locate the real repository from cwd, not from the test file __file__.",
      "type": "string"
    },
    "test_driver": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "execution_checks": {
      "description": "Required for first generated acceptance: artifact type, real entry and consuming runtime. [] only for inspection, fixed user commands, or reuse of frozen checks. Compile/syntax-check and execute the actual artifact. Wine CMD instead parses and executes the unchanged BAT/CMD once; only exercised paths are validated in compatibility mode. Invocation-only call and unchecked executable consumers are not supported. No task-name detection or self-reported pass.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
            "type": "string"
          },
          "requirement_id": {
            "type": "string"
          },
          "requirement_quote": {
            "description": "Verbatim original requirement scope; empty binds the complete original request.",
            "type": "string"
          },
          "artifact_type": {
            "enum": [
              "generated_code",
              "repository_entry"
            ],
            "type": "string"
          },
          "imports": {
            "type": "string"
          },
          "setup": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "consumer": {
            "enum": [
              "command",
              "c_expression",
              "c_statement"
            ],
            "type": "string"
          },
          "entry_file": {
            "type": "string"
          },
          "interpreter": {
            "enum": [
              "",
              "python",
              "node",
              "shell",
              "wine-cmd"
            ],
            "type": "string"
          },
          "argv": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "variables": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "result_variable": {
            "type": "string"
          },
          "cases": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "values": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "expected": {
                  "type": "number"
                }
              },
              "required": [
                "values",
                "expected"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "requirement_id",
          "requirement_quote",
          "artifact_type",
          "imports",
          "setup",
          "expression",
          "consumer",
          "entry_file",
          "interpreter",
          "argv",
          "variables",
          "result_variable",
          "cases"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "regression_command": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "note",
    "steps",
    "test_code",
    "test_driver",
    "execution_checks",
    "regression_command"
  ],
  "type": "object"
}
