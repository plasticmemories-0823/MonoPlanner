{
  "list_files": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string"
      },
      "offset": {
        "type": "integer"
      },
      "limit": {
        "type": "integer"
      }
    },
    "required": [
      "path",
      "offset",
      "limit"
    ]
  },
  "read_file": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string"
      },
      "offset": {
        "type": "integer"
      },
      "limit": {
        "type": "integer"
      },
      "reread_reason": {
        "type": "string"
      },
      "cursor": {
        "type": "string",
        "description": "Opaque next_cursor from a partial original source read; empty for a line request."
      }
    },
    "required": [
      "path",
      "offset",
      "limit",
      "reread_reason",
      "cursor"
    ]
  },
  "run_existing": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "entry": {
        "type": "string"
      },
      "args": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "timeout": {
        "type": "integer"
      },
      "usage_file": {
        "type": "string"
      }
    },
    "required": [
      "entry",
      "args",
      "timeout",
      "usage_file"
    ]
  },
  "list_applications": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "query": {
        "type": "string"
      }
    },
    "required": [
      "query"
    ]
  },
  "open_file": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string"
      },
      "application_id": {
        "type": "string"
      }
    },
    "required": [
      "path",
      "application_id"
    ]
  },
  "launch_application": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "application_id": {
        "type": "string"
      }
    },
    "required": [
      "application_id"
    ]
  },
  "request_file_operation": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "create",
          "replace",
          "copy",
          "move",
          "delete"
        ]
      },
      "path": {
        "type": "string"
      },
      "destination": {
        "type": "string"
      },
      "content": {
        "type": "string"
      }
    },
    "required": [
      "operation",
      "path",
      "destination",
      "content"
    ]
  },
  "retrieve_evidence": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "query": {
        "type": "string",
        "description": "Original query, 1..2000 characters. Exact preserves all whitespace and punctuation."
      },
      "path": {
        "type": "string",
        "description": "Authorized file or directory scope; exact may use an authorized absolute path."
      },
      "mode": {
        "type": "string",
        "enum": [
          "exact",
          "keywords"
        ],
        "description": "exact: one literal query. keywords: explicit terms, query empty. rg matches; BM25 automatically ranks files."
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "description": "Initial hit offset, default 0; use the returned cursor for subsequent pages."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "description": "Maximum hits per page, default 80, range 1..1000. Shared output budget may require continuation."
      },
      "cursor": {
        "type": "string",
        "description": "Opaque next_cursor; empty for an initial request. Bound to query and source versions."
      },
      "intent": {
        "type": "string",
        "enum": [
          "locate",
          "diagnostic",
          "audit"
        ],
        "description": "Locate, diagnostic or audit intent."
      },
      "required_entities": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Explicit required evidence entities, at most 16; empty when not required."
      },
      "required_kinds": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "code",
            "document",
            "tool_result",
            "log"
          ]
        },
        "description": "Required source types, at most 4; empty when not required."
      },
      "match": {
        "type": "string",
        "enum": [
          "whole_word",
          "substring"
        ],
        "description": "whole_word for complete identifiers; substring for partial names, error text or fragments. Case-sensitive; no rewriting."
      },
      "terms": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "keywords only: explicit literal terms, any term matches; empty for exact."
      }
    },
    "required": [
      "query",
      "path",
      "mode",
      "offset",
      "limit",
      "cursor",
      "intent",
      "required_entities",
      "required_kinds",
      "match",
      "terms"
    ]
  }
}
